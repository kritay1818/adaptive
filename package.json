{
  "name": "adactive-pet",
  "version": "0.1.2",
  "private": true,
  "description": "ADActive desktop companion",
  "author": "ADActive",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/chat-response-ui.cjs && node tests/model-window-ui.cjs && node tests/command-bar-ui.cjs && node tests/wordpress-ui.cjs && node tests/electron-ui.cjs && node tests/pet-ui.cjs && node tests/providers-ui.cjs && node tests/model-discovery-ui.cjs && node tests/wp-agent-ui.cjs",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "build:mac": "electron-builder --mac dir",
    "check": "prettier --check \"src/**/*.{cjs,js,html,css}\" \"tests/*.cjs\" package.json"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.2",
    "prettier": "3.9.9"
  },
  "build": {
    "appId": "agency.adactive.pet",
    "productName": "ADActive",
    "copyright": "ADActive",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "src/ui/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "ADActive",
      "uninstallDisplayName": "ADActive",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "ADActive-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ADActive-${version}-portable.${ext}"
    }
  }
}
